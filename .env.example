# ─────────────────────────────────────────────────────────
# Copy this file to .env and fill in your values.
# NEVER commit .env to Git.
# ─────────────────────────────────────────────────────────

# PostgreSQL
POSTGRES_PASSWORD=your_strong_password_here

# JWT signing secret (min 32 chars, random string)
# Generate with: openssl rand -hex 32
JWT_SECRET=replace_with_output_of_openssl_rand_hex_32

# Environment: development | production
ENVIRONMENT=development

# Optional: cloud deployment
# AWS_REGION=us-east-1
# AWS_ACCOUNT_ID=123456789012
# DOCKER_REGISTRY=ghcr.io/YOUR_USERNAME/e2e-encrypted-workspace

# Admin Console: comma-separated emails allowed to open it.
# Register these accounts normally in the UI (strong password required);
# on sign-in they land on the Admin Console instead of the workspace.
ADMIN_EMAILS=admin@test.com

# Max new accounts per client IP per hour (0 = unlimited)
REGISTER_MAX_PER_WINDOW=5
